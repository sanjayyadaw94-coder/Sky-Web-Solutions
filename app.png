const pages={home:['Your ideas. Our code. <em>Better digital experiences.</em>','Sky Web Solutions creates business websites, online stores, custom web applications and AI-powered digital solutions.'],services:['Digital services built for <em>your business.</em>','Explore web development, e-commerce, UI/UX, hosting, maintenance and AI automation.'],work:['Ideas for a better <em>digital world.</em>','Explore our original interactive prototypes, clearly marked as demos.'],about:['Creative thinking. <em>Practical technology.</em>','Meet a new digital solutions company committed to useful technology and thoughtful design.'],contact:["Let's build your <em>next big idea.</em>",'Tell us about the website, online store, custom application or automation you want to create.'],privacy:['Your privacy <em>matters.</em>','Learn how we handle information shared through this website.']};
const wa='https://wa.me/917898987828?text=Hello%20Sky%20Web%20Solutions%2C%20I%20want%20to%20discuss%20a%20project.';
const card=(icon,title,body)=>`<article class="card"><div class="symbol">${icon}</div><h3>${title}</h3><p>${body}</p></article>`;
const section=(eyebrow,title,body,content='')=>`<section class="section"><div class="eyebrow">${eyebrow}</div><h2>${title}</h2><p>${body}</p>${content}</section>`;
const home=section('WHY SKY WEB SOLUTIONS','Thoughtful design.<br><em>Practical results.</em>','We help businesses turn ideas into clear, useful digital experiences.',`<div class="grid">${card('◎','Built around your goals','We start with your audience, requirements and business priorities.')}${card('✳','Designed for real people','Mobile-friendly layouts and clear calls to action.')}${card('↗','Clear project planning','Scope, milestones and deliverables are discussed before development.')}</div>`)+section('HOW WE WORK','From first idea<br>to <em>launch day.</em>','A simple collaborative process from discovery to launch.',`<div class="steps">${[['01','Discover','Discuss your goals and requirements.'],['02','Design','Plan the structure and user experience.'],['03','Develop','Build responsive pages and agreed features.'],['04','Test & Launch','Review functionality and prepare deployment.']].map(x=>`<article class="step"><strong>${x[0]}</strong><h3>${x[1]}</h3><p>${x[2]}</p></article>`).join('')}</div>`)+section('WHAT WE CAN HELP WITH','One partner.<br><em>Many possibilities.</em>','Business websites, online stores, custom applications, UI/UX, maintenance, hosting and automation.','<div class="actions"><a class="btn" href="#services">Explore all 7 services ↗</a><a href="#contact">Request a custom quote ↗</a></div>')+section('COMMON QUESTIONS','Good questions.<br><em>Clear answers.</em>','',`<div class="faq"><details><summary>How do I start a project?</summary><p>Tell us your requirements via the form, WhatsApp or email.</p></details><details><summary>How much does a project cost?</summary><p>Pricing depends on the scope, features and integrations. Request a custom quote.</p></details><details><summary>Do you offer hosting and support?</summary><p>We can discuss domain, hosting and maintenance as part of your project.</p></details></div>`);
const services=['Business Website Development','E-commerce Website','Custom Web Applications','UI/UX Design','Website Maintenance & Support','Domain & Hosting Setup','AI Automation & Chatbots'];
const descriptions=['Responsive, accessible company websites with clear service and enquiry journeys.','Product catalogues, cart experiences and online store integrations.','Purpose-built web tools and workflow interfaces for specific needs.','User-focused layouts, wireframes and interface design.','Updates, troubleshooting and ongoing website improvements.','Domain registration guidance, hosting setup and deployment support.','Chatbot experiences and automation workflows tailored to your use case.'];
const servicePage=section('OUR SERVICES','What we can <em>build together.</em>','Each project is scoped around your goals and requirements.',`<div class="grid">${services.map((x,i)=>card(['↗','▣','⌘','◎','✳','☁','✦'][i],x,descriptions[i]+` <a href="#contact">Request a quote ↗</a>`)).join('')}</div>`);
const work=section('INTERACTIVE PORTFOLIO / ORIGINAL DEMOS','See ideas<br><em>in action.</em>','Sky Web Solutions is a new company. These interactive examples are prototypes, not completed client projects or production systems.',`<div class="demo-grid"><article class="demo"><div class="demo-head">01 / BUSINESS WEBSITE · INTERACTIVE CONCEPT</div><div class="preview"><small>NORTHLINE STUDIO · FICTIONAL BUSINESS</small><h3>Make your next<br><em>move count.</em></h3><p>A sample responsive business website.</p><button id="businessBtn">Explore services ↗</button><p class="demo-note" id="businessStatus">Designed for clear messaging and conversion.</p></div><h3>Business Website Prototype</h3><p>Demonstrates navigation and call-to-action behavior.</p></article><article class="demo"><div class="demo-head">02 / E-COMMERCE · INTERACTIVE CONCEPT</div><div class="preview"><strong>FORM & FUNCTION</strong><p>Bag: <b id="cartCount">0</b></p><div class="products"><div class="product"><div class="shape">✳</div><strong>Studio Lamp</strong><small>₹1,499</small><button class="addCart">Add to bag +</button></div><div class="product"><div class="shape">◈</div><strong>Ceramic Vase</strong><small>₹899</small><button class="addCart">Add to bag +</button></div></div><p class="demo-note" id="cartStatus">Demo only. No payments or orders.</p></div><h3>E-commerce Store Prototype</h3><p>Try adding sample products to a local demo cart.</p></article><article class="demo"><div class="demo-head">03 / CHATBOT · SCRIPTED INTERACTIVE CONCEPT</div><div class="preview"><strong>✦ Sky Assistant</strong><div class="chat-log" id="chatLog"><p>Assistant: Hello! What would you like help with?</p></div><div class="chat-choices"><button data-chat="website">Website</button><button data-chat="store">Online store</button><button data-chat="automation">Automation</button></div></div><h3>Chatbot Interaction Prototype</h3><p>Scripted demonstration, not a connected AI model.</p></article></div>`)+section('TRANSPARENT BY DESIGN','New company.<br><em>Clear commitments.</em>','We label demos honestly and discuss project requirements clearly.',`<div class="grid">${card('◎','Honest portfolio','Concepts are labeled. Verified client work will be shown with permission.')}${card('↗','Project-specific scope','Costs, features and milestones are agreed per engagement.')}${card('✳','Thoughtful delivery','Focus on responsive layouts, usability and maintainable solutions.')}</div>`)+section('TECHNOLOGY & DELIVERY','Right tools.<br><em>Right solution.</em>','Technologies and integrations are selected according to project requirements.',`<div class="tech">${['HTML5','CSS3','JavaScript','TypeScript','Responsive UI','APIs & Integrations','Hosting & Deployment','Automation Workflows'].map(x=>`<span>${x}</span>`).join('')}</div><p class="demo-note">Technology areas shown are not claims of certification or partnerships.</p>`);
const about=section('WHO WE ARE','A new studio.<br><em>Big ideas.</em>','Sky Web Solutions is an emerging web development and digital solutions company focused on helping businesses build a confident online presence.',`<div class="grid">${card('◎','Our Mission','Make useful digital solutions accessible to growing businesses.')}${card('↗','Our Vision','Become a trusted creative technology partner.')}${card('✳','Our Approach','Listen carefully, design thoughtfully and build responsibly.')}</div>`);
const contact=section("LET'S BUILD SOMETHING USEFUL",'Tell us what<br><em>you have in mind.</em>','Share your goals and requirements to start a conversation.',`<div class="contact-links"><a href="tel:+917898987828">Call: +91 7898987828</a><a href="mailto:sanjay.yadaw94@gmail.com">Email: sanjay.yadaw94@gmail.com</a></div><form class="form" id="contactForm"><label>Your name<input name="name" required minlength="2" maxlength="100" autocomplete="name"></label><label>Business / organisation (optional)<input name="business" maxlength="120"></label><label>Email address<input type="email" name="email" required autocomplete="email"></label><label>Phone / WhatsApp (optional)<input type="tel" name="phone" autocomplete="tel"></label><label>Service you need<select name="service" required><option value="">Choose a service</option>${services.map(x=>`<option>${x}</option>`).join('')}</select></label><label>Estimated budget (optional)<select name="budget"><option value="">Not decided yet</option><option>Under ₹25,000</option><option>₹25,000 – ₹50,000</option><option>₹50,000 – ₹1,00,000</option><option>Above ₹1,00,000</option></select></label><label>Project details<textarea name="message" required minlength="10" maxlength="3000" rows="5"></textarea></label><label class="consent"><input type="checkbox" required name="consent"> I agree to share these details for responding to my enquiry.</label><button class="btn" type="submit">Submit enquiry ↗</button><p class="form-status" id="formStatus" role="status">Your message will be sent securely if email delivery is configured on this server.</p></form>`);
const privacy=section('PRIVACY NOTICE','Your information.<br><em>Handled with care.</em>','Enquiry details are used to understand and respond to your request. The server may process your name, email, optional phone and message to send an enquiry notification. Do not share passwords or payment details. Contact sanjay.yadaw94@gmail.com with privacy requests. Hosting and email providers may process information under their own policies.');
const content={home,services:servicePage,work,about,contact,privacy};
function render(){const page=location.hash.slice(1) in pages?location.hash.slice(1):'home';document.title=`${page==='home'?'Sky Web Solutions':page[0].toUpperCase()+page.slice(1)+' | Sky Web Solutions'}`;const [title,desc]=pages[page];document.querySelector('#app').innerHTML=`<section class="hero"><div><div class="eyebrow">✳ SKY WEB SOLUTIONS / CREATIVE TECHNOLOGY STUDIO</div><h1>${title}</h1><p>${desc}</p><div class="actions"><a class="btn" href="#contact">Request a custom quote ↗</a><a href="#services">Explore services ↗</a></div></div><div class="art"><div class="editor"><small>● ● ● &nbsp; sky-solutions.ts</small><div><b>const</b> idea = 'your vision';</div><div><b>function</b> build(idea) {</div><div>&nbsp; return 'digital experience';</div><div>}</div></div></section><div class="ticker">✳ WEB DEVELOPMENT &nbsp; ✳ DIGITAL EXPERIENCES &nbsp; ✳ E-COMMERCE &nbsp; ✳ AI AUTOMATION &nbsp; ✳ WEB DEVELOPMENT &nbsp; ✳ DIGITAL EXPERIENCES</div>${content[page]}${page==='home'?'<section class="closing"><h2>Have a project<br><em>in mind?</em></h2><a href="#contact">Request a custom quote ↗</a></section>':''}`;document.querySelectorAll('#nav a').forEach(a=>a.classList.toggle('active',a.hash==='#'+page));bind();window.scrollTo(0,0)}
function bind(){document.getElementById('businessBtn')?.addEventListener('click',()=>document.getElementById('businessStatus').textContent='Services: Branding · Web Design · Digital Strategy. Fictional example.');let count=0;document.querySelectorAll('.addCart').forEach(b=>b.addEventListener('click',()=>{document.getElementById('cartCount').textContent=++count;document.getElementById('cartStatus').textContent=`${count} sample item(s) in demo bag. No checkout or payment.`}));const answers={website:'We can discuss a responsive business website.',store:'We can discuss an online store and checkout requirements.',automation:'We can explore chatbot and workflow automation options.'};document.querySelectorAll('[data-chat]').forEach(b=>b.addEventListener('click',()=>{const el=document.getElementById('chatLog');const q=document.createElement('p');q.className='user';q.textContent='You: '+b.textContent;const a=document.createElement('p');a.textContent='Assistant: '+answers[b.dataset.chat];el.append(q,a);el.scrollTop=el.scrollHeight}));document.getElementById('contactForm')?.addEventListener('submit',e=>{e.preventDefault();const form=e.currentTarget,status=document.getElementById('formStatus');if(!form.reportValidity())return;const data=new FormData(form);const fields=[['Name','name'],['Business','business'],['Email','email'],['Phone','phone'],['Service','service'],['Budget','budget'],['Project details','message']];const body=fields.map(([label,key])=>label+': '+(data.get(key)||'Not specified')).join('\n');const subject='Project Enquiry - '+(data.get('service')||'Sky Web Solutions');status.textContent='Opening your email application. Press Send there to deliver your enquiry.';window.location.href='mailto:sanjay.yadaw94@gmail.com?subject='+encodeURIComponent(subject)+'&body='+encodeURIComponent(body);})}
document.getElementById('menu').addEventListener('click',()=>document.getElementById('nav').classList.toggle('open'));window.addEventListener('hashchange',()=>{document.getElementById('nav').classList.remove('open');render()});render();